{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "diplom-23056",
          "appId": "1:464701040005:android:52cfd4c10c6f83b11a10ec",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "diplom-23056",
          "configurations": {
            "android": "1:464701040005:android:52cfd4c10c6f83b11a10ec",
            "ios": "1:464701040005:ios:f4c2aed6a31ba9e11a10ec",
            "macos": "1:464701040005:ios:f4c2aed6a31ba9e11a10ec",
            "web": "1:464701040005:web:8b1bbfc349926d481a10ec",
            "windows": "1:464701040005:web:81354736644084831a10ec"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/hosting",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/ai/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=900"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/mse/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "regex": "^/(index\\.html|flutter_bootstrap\\.js|flutter_service_worker\\.js|main\\.dart\\.js|version\\.json|manifest\\.json)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
